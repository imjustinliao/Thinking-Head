{
  "name": "thinking-head",
  "version": "0.0.0",
  "description": "A lightweight animated modular-mech status indicator for AI products.",
  "type": "module",
  "license": "MIT",
  "author": "Justin Liao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imjustinliao/Thinking-Head.git"
  },
  "keywords": [
    "ai",
    "agent",
    "loading",
    "indicator",
    "svg",
    "animation",
    "mech",
    "status"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "workspaces": [
    "demo"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "dev": "npm run dev --workspace demo",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
