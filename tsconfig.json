{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    // Mirrors the demo's Vite aliases so the demo typechecks against package source.
    "paths": {
      "thinking-head": ["./src/index.ts"],
      "thinking-head/dev": ["./src/dev.ts"]
    },

    "strict": true,
    // noUncheckedIndexedAccess is deliberately off. It types every typed-array read as
    // `number | undefined`, which would put a non-null assertion on essentially every line
    // of the geometry and render kernels — noisier and no safer. Its real value is on
    // records and plain arrays, and TypeScript already treats our union-keyed Record
    // lookups as non-optional. Every other strict flag stays on.
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "declaration": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "demo/src", "demo/vite.config.ts", "vite.config.ts"]
}
